# EditorConfig is awesome: https://EditorConfig.org

# 顶层配置文件标识
root = true

# 所有文件的默认配置
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown 文件特殊配置
[*.md]
trim_trailing_whitespace = false

# package.json 或其他 JSON 文件配置
[*.{json,json5,webmanifest}]
indent_size = 2

# TypeScript 和 JavaScript 文件配置
[*.{js,jsx,ts,tsx,vue}]
indent_size = 2
quote_type = single

# CSS, SCSS, LESS 文件配置
[*.{css,scss,less,styl}]
indent_size = 2

# HTML 文件配置
[*.{htm,html}]
indent_size = 2
max_line_length = 100
